SERVICE_NAME=Wathiq Classifier Service
DATABASE_PATH=./storage/wathiq_classifier.db
DEFAULT_INSTITUTION_ID=default-institution
MODEL_DEVICE=auto
E5_MODEL=intfloat/multilingual-e5-base
